# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database (Uses built-in persistent SQLite)
DATABASE_PATH=./data/cloudguard.db

# Gemini AI (for security findings explanation)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# AWS Credentials (Optional for production scanning)
# If left blank, the scanner operates in safe development/simulated mode
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
